"""The DF-MP2 gradient we drafted for pyscf (TASKS 321), at a corpus geometry, for the comparison with psi4's.

Runs in WSL with the pyscf worktree of the draft on PYTHONPATH (~/pyscf-wt-dfmp2grad, branch df-mp2-grad). The reference is a
density-fitted RHF in <jkfit set>, the correlation part is fitted in <ri set> (set on `mp.with_df`), as psi4 does it.

    python pyscf_grad.py <geometry.json> <basis name or NWChem file> <jkfit set> <ri set> <frozen> <max_memory MB> <out.npz>
"""
from __future__ import annotations

import json
import resource
import sys
import time
from pathlib import Path

import numpy as np

USAGE = "pyscf_grad.py <geometry.json> <basis name or NWChem file> <jkfit set> <ri set> <frozen> <max_memory MB> <out.npz>"


def load_geometry(path: Path) -> tuple[list[str], np.ndarray]:
    """Element symbols and coordinates in bohr of a corpus geometry.json."""
    record = json.loads(path.read_text(encoding="utf-8"))
    return [s.capitalize() for s in record["symbols"]], np.asarray(record["coords_bohr"], float).reshape(-1, 3)


def main(argv: list[str]) -> int:
    if len(argv) != 7:
        raise SystemExit(USAGE)
    from pyscf import df, gto, lib, mp, scf  # here: the script's usage line must not need pyscf

    geometry, basis, jkfit, ri, frozen, max_memory, out = argv
    symbols, coords = load_geometry(Path(geometry))
    if Path(basis).is_file():
        basis = {s: gto.basis.load(basis, s) for s in sorted(set(symbols))}
    mol = gto.M(atom=list(zip(symbols, coords, strict=True)), basis=basis, unit="Bohr", verbose=4, max_memory=float(max_memory))
    print(f"nao {mol.nao}, threads {lib.num_threads()}, max_memory {mol.max_memory} MB", flush=True)
    stamps = [time.time()]
    mf = scf.RHF(mol).density_fit(auxbasis=jkfit)
    mf.conv_tol = 1e-12
    mf.kernel()
    stamps.append(time.time())
    pt = mp.dfmp2.DFMP2(mf, frozen=int(frozen))
    pt.with_df = df.DF(mol, auxbasis=ri)
    pt.kernel()
    stamps.append(time.time())
    gradient = pt.nuc_grad_method().kernel()
    stamps.append(time.time())
    seconds = np.diff(stamps)
    peak_gb = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024 ** 2
    np.savez(out, gradient=gradient, e_scf=mf.e_tot, e_tot=pt.e_tot, coords_bohr=coords, seconds=seconds, peak_gb=peak_gb)
    print(f"=== PYSCF GRAD DONE e_tot {pt.e_tot:.10f}; scf {seconds[0]:.0f} s, mp2 {seconds[1]:.0f} s, gradient {seconds[2]:.0f} s; "
          f"peak RSS {peak_gb:.2f} GB", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
